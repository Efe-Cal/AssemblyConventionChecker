{
  "name": "assembly-convention-checker-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/vscode"],
  "scripts": {
    "build": "npm run build --workspace packages/vscode",
    "watch": "npm run watch --workspace packages/vscode",
    "test": "npm run test:checker && npm run test:extension",
    "test:checker": "python scripts/test-checker.py",
    "test:extension": "npm run test --workspace packages/vscode",
    "test:integration": "npm run test:integration --workspace packages/vscode",
    "test:visual": "npm run test:visual --workspace packages/vscode",
    "test:package": "python scripts/smoke-package.py",
    "package": "npm run package --workspace packages/vscode"
  },
  "engines": {"node": ">=22"}
}
